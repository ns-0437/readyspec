  "distractors": ["src/reports/sales-report.ts"],
  "criticalAmbiguities": [
    { "id": "metric", "description": "No baseline or target: what latency, measured where, is 'slow'?", "anyOf": [["latency|slow|metric|baseline|measure|how fast|target|performance|seconds|ms", "order|checkout|placing"]] },
    { "id": "where-slow", "description": "Which step is the bottleneck (none is evidenced).", "anyOf": [["bottleneck|profil|which step|where|slowest|step", "slow|order|checkout"]] }
  ],
  "acceptableTopics": [[["user|customer|internal|api", "slow|faster|checkout"]]],
  "unacceptableAssumptions": [
    { "id": "invents-bottleneck", "description": "Asserting a bottleneck without evidence.", "pattern": "the (main |primary |real )?bottleneck is" }
  ],
  "shouldSayInsufficientEvidence": true
}
