# Copy to .env.local (never commit real keys). All optional: with no key the app runs the labelled fixture provider.
# Set ONE of these to enable a real model. If both are set, Anthropic is used unless READYSPEC_PROVIDER says otherwise.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=                       # or GOOGLE_API_KEY
# READYSPEC_PROVIDER=fixture            # fixture | anthropic | gemini
# READYSPEC_MODEL=                      # overrides the default model id for whichever provider is selected
# ANTHROPIC_BASE_URL=                   # testing only
# GEMINI_BASE_URL=                      # testing only
# READYSPEC_ALLOWED_ROOTS=C:\path\to\repos   # path-delimited (; on Windows, : elsewhere); fixtures are always allowed
# READYSPEC_MAX_CALLS=14
# READYSPEC_MAX_INPUT_TOKENS=200000
# READYSPEC_MAX_OUTPUT_TOKENS=60000
# READYSPEC_MAX_COST_USD=
# READYSPEC_PRICE_IN_PER_MTOK=
# READYSPEC_PRICE_OUT_PER_MTOK=
# READYSPEC_DB=data/readyspec.db
